{
  "name": "curator-plugins",
  "private": true,
  "scripts": {
    "build": "node build.js --all",
    "build:image-converter": "node build.js --plugin image-converter",
    "build:ffmpeg-transcoder": "node build.js --plugin ffmpeg-transcoder",
    "build:image-compare": "node build.js --plugin image-compare",
    "build:gif-maker": "node build.js --plugin gif-maker",
    "build:minipaint": "node build.js --plugin minipaint",
    "build:aria2-downloader": "node build.js --plugin aria2-downloader",
    "build:dynasty-scans": "node build.js --plugin dynasty-scans",
    "watch:image-converter": "node watch.js --plugin image-converter",
    "watch:ffmpeg-transcoder": "node watch.js --plugin ffmpeg-transcoder",
    "watch:image-compare": "node watch.js --plugin image-compare",
    "watch:gif-maker": "node watch.js --plugin gif-maker",
    "watch:minipaint": "node watch.js --plugin minipaint",
    "watch:aria2-downloader": "node watch.js --plugin aria2-downloader",
    "watch:dynasty-scans": "node watch.js --plugin dynasty-scans",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
