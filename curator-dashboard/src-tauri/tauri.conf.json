{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "curator-dashboard",
  "version": "0.1.0",
  "identifier": "dev.curator.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../../curator-service/src",
      "../../curator-core/src",
      "../../curator-db/src",
      "../../curator-ml/src",
      "../../curator-media/src",
      "../../curator-filename-parser/src",
      "../../curator-proto/proto"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "curator-dashboard",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
